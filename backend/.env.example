# Environment Configuration Template

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Redis Configuration (For LangGraph state checkpointing)
REDIS_URL=redis://localhost:6379/0

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/procureai_db

# Application Configuration
APP_ENV=development
LOG_LEVEL=info
